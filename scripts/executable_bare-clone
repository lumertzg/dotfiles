#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: bare-clone <repository-url> [directory]" >&2
}

if (( $# < 1 || $# > 2 )); then
    usage
    exit 2
fi

url=$1
basename=${url##*/}
name=${2:-${basename%.git}}

if [[ -z $name ]]; then
    echo "bare-clone: could not derive a directory name" >&2
    exit 2
fi

mkdir -- "$name"
cd -- "$name"

# Keep repository administration under .bare and worktrees beside it.
git clone --bare "$url" .bare
printf 'gitdir: ./.bare\n' >.git

# Fetch remote branches so they can be checked out as worktrees.
git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
git fetch origin
